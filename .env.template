SERVER_HOST="localhost"
SERVER_PORT="8080"
SERVER_LOCATION="${SERVER_HOST}:${SERVER_PORT}"

#DB server
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"

#POSTGRES PORT CHANGE
PGPORT=${POSTGRES_PORT}

#DB
POSTGRES_DB="authentication_provider"
POSTGRES_USER=""
POSTGRES_PASSWORD=""

#Authentication server 
AUTHENTICATION_HOST="authentication_provider"
AUTHENTICATION_PORT="8080"
AUTHENTICATION_SCHEME="http"

API_LOCATION=${AUTHENTICATION_SCHEME}://${AUTHENTICATION_HOST}:${AUTHENTICATION_PORT}

#Authentication server .NET variables
ASPNETCORE_HTTP_PORTS=${AUTHENTICATION_PORT}

ConnectionStrings__Default="Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"

TokenSettings__Issuer="${SERVER_LOCATION}"
TokenSettings__Audience="${SERVER_LOCATION}"
TokenSettings__Lifetime="00:15:00"
TokenSettings__CookieName="X-ACCESS-TOKEN"
#Currently uses hmac_sha256 symmetric key, aka signing key should be equal to verification one
TokenKeyPairSettings__SigningKey=""
TokenKeyPairSettings__VerificationKey=""
