TokenSettings__Issuer=${SERVER_LOCATION}
TokenSettings__Audience=${SERVER_LOCATION}
TokenSettings__Lifetime=00:15:00
TokenSettings__CookieName=X-ACCESS-TOKEN

ServerSettings__UrlPrefix=api/
ServerSettings__AppVersion=v1
ServerSettings__DomainName=localhost

CookieSettings__HttpOnly=true
CookieSettings__Secure=false
CookieSettings__SameSiteMode=Lax